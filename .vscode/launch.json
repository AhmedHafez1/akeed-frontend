{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: NestJS (Debug 9230)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "${workspaceFolder}/../akeed-backend/node_modules/@nestjs/cli/bin/nest.js",
        "start",
        "--watch",
        "--debug",
        "9230"
      ],
      "cwd": "${workspaceFolder}/../akeed-backend",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/../akeed-backend/.env",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Redis: Start and Wait",
      "postDebugTask": "Redis: Stop"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Frontend: Standalone (3001)",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "NEXT_DIST_DIR": ".next/standalone",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3001"
      }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Frontend: Shopify CLI (3002)",
      "command": "npm.cmd run shopify:dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "NEXT_DIST_DIR": ".next/shopify",
        "NODE_OPTIONS": "--dns-result-order=ipv4first",
        "SHOPIFY_CLI_NO_ANALYTICS": "1"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Standalone + Shopify",
      "configurations": [
        "Backend: NestJS (Debug 9230)",
        "Frontend: Standalone (3001)",
        "Frontend: Shopify CLI (3002)"
      ],
      "stopAll": true
    }
  ]
}
