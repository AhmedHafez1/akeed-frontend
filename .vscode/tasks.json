{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Redis: Start and Wait",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\DockerDesktop\\resources\\bin\\docker.exe",
      "args": [
        "compose",
        "-f",
        "${workspaceFolder}/../akeed-backend/compose.local.yml",
        "up",
        "-d",
        "--wait"
      ],
      "problemMatcher": []
    },
    {
      "label": "Redis: Stop",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Programs\\DockerDesktop\\resources\\bin\\docker.exe",
      "args": [
        "compose",
        "-f",
        "${workspaceFolder}/../akeed-backend/compose.local.yml",
        "down"
      ],
      "problemMatcher": []
    }
  ]
}
