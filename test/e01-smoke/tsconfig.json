{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": { "@/*": ["../../src/*"] },
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "../../src/**/*.d.ts",
    "../../src/shared/types/window.model.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
